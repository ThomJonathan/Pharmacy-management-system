+
+  /// Fallback used only when v_sellable_stock is not deployed yet. Mirrors its
+  /// rules: ignore expired batches, sum available quantity per item, and show
+  /// the lowest current selling price.
+  Future<List<Map<String, dynamic>>> _stockFromInventory(
+    String branchId,
+    List<String> ids,
+  ) async {
+    final now = DateTime.now();
+    final today =
+        '${now.year}-${now.month.toString().padLeft(2, '0')}-${now.day.toString().padLeft(2, '0')}';
+    final rows = await _client
+        .from('inventory')
+        .select('item_id, quantity_available, retail_price, wholesale_price, expiry_date')
+        .eq('branch_id', branchId)
+        .inFilter('item_id', ids)
+        .gt('quantity_available', 0)
+        .limit(5000) as List;
+
+    final out = <String, Map<String, dynamic>>{};
+    for (final r in rows) {
+      final expiry = r['expiry_date'] as String?;
+      if (expiry != null && expiry.compareTo(today) < 0) continue;
+      final id = r['item_id'] as String;
+      final qty = ((r['quantity_available'] as num?) ?? 0).toDouble();
+      final retail = ((r['retail_price'] as num?) ?? 0).toDouble();
+      final wholesale = (r['wholesale_price'] as num?)?.toDouble();
+      final current = out[id];
+      if (current == null) {
+        out[id] = {
+          'item_id': id,
+          'sellable_quantity': qty,
+          'retail_price': retail,
+          'wholesale_price': wholesale,
+        };
+      } else {
+        current['sellable_quantity'] =
+            (current['sellable_quantity'] as double) + qty;
+        if (retail < (current['retail_price'] as double)) {
+          current['retail_price'] = retail;
+        }
+        final currentWholesale = current['wholesale_price'] as double?;
+        if (wholesale != null &&
+            (currentWholesale == null || wholesale < currentWholesale)) {
+          current['wholesale_price'] = wholesale;
+        }
+      }
+    }
+    return out.values.toList();
+  }
+
+  /// Postgres/PostgREST errors that mean "this database is missing the newer
+  /// optional column/view", not "the query is wrong":
+  ///   42703     undefined column (quantity_step, sale_items.unit, ...)
+  ///   PGRST200  no relationship between items and item_units
+  ///   PGRST204  column missing from PostgREST's schema cache
+  ///   PGRST205  table/view missing from PostgREST's schema cache
+  bool _isOptionalSchemaError(PostgrestException e) {
+    const codes = {'42703', 'PGRST200', 'PGRST204', 'PGRST205'};
+    if (codes.contains(e.code)) return true;
+    final m = e.message.toLowerCase();
+    return m.contains('quantity_step') ||
+        m.contains('item_units') ||
+        m.contains('v_sellable_stock') ||
+        m.contains('schema cache');
+  }
